{
  "name": "camera-tracker",
  "version": "0.0.0",
  "private": true,
  "description": "Free price-history and restock site for camera gear.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "seed:check": "node src/seed/load.ts seed/fujifilm.json --check",
    "seed:local": "node src/seed/load.ts seed/fujifilm.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply camera-tracker-db --local",
    "db:tables:local": "wrangler d1 execute camera-tracker-db --local --command \"SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name\""
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
